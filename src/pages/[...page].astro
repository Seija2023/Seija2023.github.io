---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderTitle from "../components/partial/HeaderTitle.astro";
import HeaderSubTitle from "../components/partial/HeaderSubTitle.astro";
import Footer from "../components/Footer.astro";
import Pagination from "../components/Pagination.astro";
import { SITE } from "../utils/config";
import { urlFor } from "../utils/urlFor";
import { formatDate } from "../utils/formatDate";
type Props={page:{data:CollectionEntry<"blog">[];url:{prev:string;next:string};currentPage:number;lastPage:number}};
export async function getStaticPaths({paginate}:{paginate:Function}){
  const posts=(await getCollection("blog")).sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime());
  return paginate(posts,{pageSize:10});
}
const {page}=Astro.props;
---
<BaseLayout>
  <HeaderTitle title={SITE.title} url={urlFor("/")} slot="header" />
  <HeaderSubTitle subtitle={SITE.subtitle} url={urlFor("/")} slot="header"/>
  <section id="main" class="home-area" aria-label="博客文章">
    <div class="intro-card">
      <span class="eyebrow">WELCOME TO MY BLOG</span>
      <h2>记录技术，也记录生活。</h2>
      <p>围绕工程技术、科研学习与编程实践分享笔记；也记录旅行见闻、摄影和日常思考。</p>
      <div class="intro-links">
        <a href={urlFor("/tech")}>浏览技术分享 →</a>
        <a href={urlFor("/life")}>浏览生活记录 →</a>
      </div>
    </div>
    <div class="section-heading"><h2>最新文章</h2><a href={urlFor("/archives")}>全部归档 →</a></div>
    <div class="post-feed">
      {page.data.map(post=>(
        <a class="post-card" href={urlFor(`blog/${post.id}`)}>
          <div class="post-top">
            <span>{post.data.categories?.[0] ?? "随笔"}</span>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.excerpt ?? post.data.description}</p>
          <span class="read-more">阅读全文 →</span>
        </a>
      ))}
    </div>
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} currentPage={page.currentPage} lastPage={page.lastPage}/>
  </section>
  <Footer slot="footer"/>
</BaseLayout>
<style>
.intro-card{padding:38px 42px;border-radius:14px;background:var(--color-wrap);border:1px solid var(--color-border);margin-bottom:28px;}
.eyebrow{font-size:11px;letter-spacing:.14em;color:var(--color-link);font-weight:700;}
.intro-card h2{font-size:30px;line-height:1.3;font-weight:700;color:var(--color-default);margin:12px 0;}
.intro-card p{font-size:15px;color:var(--grey-9);line-height:1.8;margin:0;max-width:680px;}
.intro-links{display:flex;flex-wrap:wrap;gap:18px;margin-top:25px;}
.intro-links a,.section-heading a{font-size:14px;color:var(--color-link);text-decoration:none;font-weight:600;}
.section-heading{display:flex;justify-content:space-between;align-items:center;margin:18px 0;}
.section-heading h2{font-size:19px;font-weight:700;color:var(--color-default);}
.post-feed{display:grid;gap:15px;}
.post-card{display:block;text-decoration:none;background:var(--color-wrap);border-radius:12px;padding:25px 32px;border:1px solid var(--color-border);transition:border-color .16s,transform .16s;}
.post-card:hover{border-color:var(--red-3);transform:translateY(-1px);}
.post-top{display:flex;justify-content:space-between;color:var(--grey-9);font-size:12px;}
.post-top span{color:var(--color-link);font-weight:600;}
.post-card h3{margin:12px 0 8px;color:var(--color-default);font-size:22px;line-height:1.4;font-weight:700;}
.post-card p{margin:0 0 14px;color:var(--grey-9);line-height:1.7;font-size:14px;}
.read-more{color:var(--color-link);font-size:13px;font-weight:600;}
@media(max-width:767px){.intro-card{padding:26px 22px}.intro-card h2{font-size:25px}.post-card{padding:22px}.post-card h3{font-size:19px}}
</style>
