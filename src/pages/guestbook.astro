---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import HeaderTitle from "../components/partial/HeaderTitle.astro";
import WalineComment from "../components/post/comment/WalineComment.astro";
import {WALINE} from "../utils/config";
import {urlFor} from "../utils/urlFor";
const open = WALINE.enable && Boolean(WALINE.serverURL);
---
<BaseLayout title="留言板" description="交流与留言">
  <HeaderTitle title="留言板" url={urlFor("/")} slot="header"/>
  <section id="main" aria-label="留言板">
    <div class="guestbook-intro"><h2>留言板</h2><p>欢迎交流技术问题、分享阅读感受或留下建议。无需注册即可留言；评论经审核后公开显示。</p></div>
    {open ? <WalineComment /> : <div class="guestbook-offline"><h3>评论功能暂未开放</h3><p>网站已经上线，匿名评论服务仍在配置中。开放后可以直接填写昵称并留言，无需注册 GitHub 账号。</p></div>}
  </section>
  <Footer slot="footer"/>
</BaseLayout>
<style>
.guestbook-intro,.guestbook-offline{background:var(--color-wrap);border:1px solid var(--color-border);border-radius:12px;padding:30px;margin-bottom:18px;}
.guestbook-intro h2{font-size:25px;font-weight:700;margin:0 0 8px;}
.guestbook-offline h3{font-weight:700;font-size:18px;margin:0 0 10px;}
.guestbook-intro p,.guestbook-offline p{font-size:14px;line-height:1.8;color:var(--grey-9);margin:0;}
</style>
