---
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"a">;
const { href, ...props } = Astro.props;
---
<a class="minimal-nav-link" href={href} {...props}><slot /></a>
<style>
.minimal-nav-link { display:inline-flex;align-items:center;padding:20px 12px;color:var(--color-default);font-size:14px;font-weight:600;text-decoration:none;transition:color .15s;white-space:nowrap; }
.minimal-nav-link:hover {color:var(--color-link);}
@media(max-width:767px){.minimal-nav-link{display:none}}
</style>
