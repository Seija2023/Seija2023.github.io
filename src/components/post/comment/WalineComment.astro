---
import { WALINE } from "../../../utils/config";
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
<div id="comments" class="waline-comment"></div>
<script data-astro-rerun is:inline define:vars={{ WALINE, turnstileKey }} type="module">
  import { init } from "https://unpkg.com/@waline/client@v3/dist/waline.js";
  init({
    el: ".waline-comment",
    serverURL: WALINE.serverURL,
    lang: WALINE.lang,
    locale: { ...WALINE.locale, placeholder: "欢迎留言。评论提交后需要管理员审核。" },
    emoji: WALINE.emoji,
    meta: WALINE.meta,
    requiredMeta: WALINE.requiredMeta,
    wordLimit: WALINE.wordLimit,
    login: "disable",
    imageUploader: false,
    comment: true,
    pageSize: WALINE.pageSize,
    dark: 'html[data-theme="dark"]',
    pageview: WALINE.pageview,
    turnstileKey: turnstileKey || undefined,
  });
</script>
<style is:global>
.waline-comment { --waline-theme-color: #315e89; --waline-active-color: #244e74; }
[data-theme="dark"] .waline-comment { --waline-theme-color: #a9cbe9; --waline-active-color: #c1dcf4; }
.wl-panel { margin: 0.5em 0; border-radius: 10px; }
.wl-emoji-popup { max-width: calc(100vw - 90px) !important; }
</style>
