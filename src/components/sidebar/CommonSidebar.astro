---
import { getCollection } from "astro:content";
import { SITE, MENU, SIDEBAR } from "../../utils/config";
import { __ } from "../../utils/i18n";
import SocialList from "./SocialList.astro";
import { urlFor } from "../../utils/urlFor";
const posts=await getCollection("blog");
const allTags=new Set(posts.flatMap(p=>p.data.tags??[]));
---
<section class="profile">
  <img src={urlFor(SIDEBAR.avatar)} width="78" height="78" alt="网站标志" />
  <h2>{SITE.author}</h2>
  <p>{SITE.description}</p>
  <div class="stats"><span>{posts.length} 篇文章</span><span>{allTags.size} 个标签</span></div>
  <SocialList />
</section>
<nav class="profile-links" aria-label="栏目导航">
  {MENU.map(item=><a href={urlFor(item.url)}>{__(item.name)}</a>)}
</nav>
<style>
.profile{padding:26px 18px 16px;text-align:center;width:100%;box-sizing:border-box;}
.profile img{width:78px;height:78px;object-fit:cover;border-radius:20px;box-shadow:none;}
.profile h2{font-size:20px;font-weight:700;margin:14px 0 8px;color:var(--color-default);}
.profile p{color:var(--grey-9);font-size:13px;line-height:1.7;margin:0 auto 12px;max-width:245px;}
.stats{display:flex;gap:18px;justify-content:center;font-size:12px;color:var(--grey-9);padding:14px 0;}
.profile-links{display:grid;gap:4px;width:100%;padding:8px 18px 24px;box-sizing:border-box;}
.profile-links a{display:block;border-radius:8px;padding:9px 14px;color:var(--color-default);font-size:14px;text-align:left;text-decoration:none;font-weight:500;}
.profile-links a:hover{background:var(--red-5);color:var(--color-link);}
</style>
