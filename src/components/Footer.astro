---
import { SITE, FOOTER } from "../utils/config";
---
<footer class="site-footer">
  <p>© {FOOTER.since}–{new Date().getFullYear()} {SITE.author}. 内容记录与分享。</p>
  <p><a href="/about">关于本站</a> <span aria-hidden="true">·</span> <a href="https://github.com/Seija2023" target="_blank" rel="noopener noreferrer">GitHub</a></p>
</footer>
<style>
.site-footer{margin-top:64px;padding:24px 16px 35px;text-align:center;background:var(--color-footer-background);color:var(--grey-9);font-size:13px;border-top:1px solid var(--color-border);}
.site-footer p{margin:4px 0;}
.site-footer a{color:var(--color-link);text-decoration:none;}
.site-footer a:hover{text-decoration:underline;}
.site-footer span{padding:0 8px;}
</style>
