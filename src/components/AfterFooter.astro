<script>
  import AOS from "@reimujs/aos";
  const initAos = () => AOS.init({duration: 360, easing: "ease-out", once: true, offset: 24});
  initAos();
  document.addEventListener("astro:after-swap", initAos);
</script>
<script>
  const syncTheme = () => {
    const saved = JSON.parse(localStorage.getItem("theme") ?? '"auto"');
    const theme = saved === "auto" ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : saved;
    if (theme === "dark") {
      document.documentElement.setAttribute("data-theme", "dark");
      document.documentElement.style.colorScheme = "dark";
    } else {
      document.documentElement.removeAttribute("data-theme");
      document.documentElement.style.colorScheme = "light";
    }
  };
  syncTheme();
  document.addEventListener("astro:after-swap", syncTheme);
</script>
