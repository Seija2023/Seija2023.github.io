.sidebar-top {
  position: fixed;
  right: 24px;
  bottom: 24px;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 42px;
  height: 42px;
  padding: 0;
  background: var(--color-wrap);
  color: var(--color-link);
  border: 1px solid var(--color-border);
  border-radius: 12px;
  box-shadow: 0 4px 18px rgba(16,33,52,.10);
  z-index: 999;
  cursor: pointer;
  transition: opacity .18s ease;
  .arrow-up { width: 17px; height: 17px; }
}